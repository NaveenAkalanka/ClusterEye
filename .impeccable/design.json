  "narrative": {
    "northStar": "The Lab Ledger",
    "overview": "ClusterEye is a careful record book kept by one person for their own lab, opened when they need to know what runs where, or when they are about to change something. It should feel quiet, exact, and trustworthy. Dark moss surfaces stay out of the way, and a single sage accent marks what you can act on. The numbers, names, and addresses are the content; everything else recedes around them.\n\nA ledger records; it does not monitor. Nothing in this system may look live, measured, or current unless it is, so there are no pulsing dots, status glows, or telemetry flourishes. Trust comes from precision instead: IPs in a monospace face, consistent columns, plain language about what is unknown, and rows that line up the same way on every page.\n\nDensity is moderate and task-led. Screens are built for fast lookup and low-effort upkeep, with controls in one predictable sidebar and the records beside it. Components are quiet and precise: restrained surfaces and thin edges, with colour saved for the main action and for state.",
    "keyCharacteristics": [
      "Dark only, with moss-tinted neutrals rather than pure greys.",
      "One accent, Lab Sage, reserved for primary actions, current state, and recorded data.",
      "Depth from tonal steps and hairlines, with shadows only on what floats.",
      "Outfit for words, Roboto Mono for values.",
      "Every record looks and behaves the same across pages.",
      "On each load the ledger fills in: panels, then records, then charts."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Sage marks what you can act on and what is selected. If it appears on something inert, remove it.",
        "section": "colors"
      },
      {
        "name": "The Signal Rule",
        "body": "Brass and Clay only ever mean something needs attention. They are never decoration, and they always come with words or an icon, never colour alone.",
        "section": "colors"
      },
      {
        "name": "The Visible Step Rule",
        "body": "A record must be visibly distinct from its panel: a solid Moss Raised fill plus a hairline. Translucent fills that blend into the panel don't count.",
        "section": "colors"
      },
      {
        "name": "The Values Are Mono Rule",
        "body": "Anything measured, addressed, or identified is Roboto Mono. Names, labels, and sentences are Outfit. Mono is never used as a \"technical\" decoration on words.",
        "section": "typography"
      },
      {
        "name": "The Title Case Rule",
        "body": "Labels, headings, and buttons use Title Case; sentences use sentence case. Case is written in the copy, never applied with uppercase styling or wide tracking.",
        "section": "typography"
      },
      {
        "name": "The Only Floaters Cast Shadows Rule",
        "body": "Records and controls on a panel stay flat. If it doesn't float over other content, it doesn't get a strong shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the theme tokens for every interface colour; only cluster colours stay inline.",
      "Do keep the navbar and page content on exactly the same left and right edges.",
      "Do show values in Roboto Mono with tabular figures, and keep IP addresses untruncated.",
      "Do say plainly when something is unknown, such as \"Other addresses haven't been checked and may be in use.\"",
      "Do give every control hover, focus, disabled, and loading states, and every list an empty state with a next step.",
      "Do keep text at 4.5:1 or better, and input and select borders at 3:1 or better.",
      "Do use Brass from 85% allocated, the same threshold on every page."
    ],
    "donts": [
      "Don't add pulsing dots, glows, \"live\" labels, or anything else implying measured or current status.",
      "Don't add small uppercase eyebrow labels above headings, or apply uppercase styling or wide tracking to labels.",
      "Don't use decorative grid-line backgrounds; the only grid here is the Subnet Map, which is real data.",
      "Don't use gradients on buttons or borders, or blur behind dialogs.",
      "Don't make anyone wait for motion: all panels should begin arriving within about 300ms, and charts should finish within about a second. No bounce, parallax, or looping effects outside loading states.",
      "Don't use translucent row fills that blend into the panel, or borders below 3:1 as an input's only edge.",
      "Don't use disabled inputs to display values, because they can't be reliably selected or copied."
    ]
  }
}
